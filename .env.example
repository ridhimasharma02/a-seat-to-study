# Copy this file to .env, or run `npm run connect-supabase` to create .env for you.
# Supabase > Connect > "Session pooler" connection string, with your database password filled in:
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Optional: path to Supabase's CA certificate (Project Settings > Database > SSL) to verify the server certificate.
# SUPABASE_CA=./prod-ca-2021.crt
